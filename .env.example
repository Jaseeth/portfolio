# Leave empty if React and ASP.NET Core are hosted under the same domain.
VITE_API_BASE_URL=

# Optional repository URL prefix, for example /jaseeth-portfolio/.
# GitHub Actions obtains this automatically from configure-pages.
# VITE_BASE_PATH=/jaseeth-portfolio/

# Example for a separate API host:
# VITE_API_BASE_URL=https://api.yourdomain.com
